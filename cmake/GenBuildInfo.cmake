# 在 build 阶段动态生成 BuildInfo.h：
#   - git rev-parse --short=4 HEAD（4 字符短 hash，失败时回退 "nogit"）
#   - 月日时分 %m%d%H%M（8 字符，不含年份和秒，够用且紧凑）
#   - 组合成 "158f-10280913" 这种唯一子版本号
# 每次 make 都会触发（add_custom_target ALL + add_dependencies）

execute_process(
    COMMAND git rev-parse --short=4 HEAD
    WORKING_DIRECTORY ${SRC_DIR}
    OUTPUT_VARIABLE GIT_HASH
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
if(NOT GIT_HASH)
    set(GIT_HASH "nogit")
endif()

execute_process(
    COMMAND date +%m%d%H%M
    OUTPUT_VARIABLE BUILD_TS
    OUTPUT_STRIP_TRAILING_WHITESPACE)

set(SUFFIX "${GIT_HASH}-${BUILD_TS}")

file(WRITE ${OUT}
    "#ifndef SIMPLEPLAYER_BUILDINFO_H\n"
    "#define SIMPLEPLAYER_BUILDINFO_H\n"
    "\n"
    "// Auto-generated by cmake/GenBuildInfo.cmake — do not edit\n"
    "#define APP_BUILD_SUFFIX \"${SUFFIX}\"\n"
    "\n"
    "#endif\n")
